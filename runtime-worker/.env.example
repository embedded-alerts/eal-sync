DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/eal
EAL_API_BASE_URL=http://127.0.0.1:8080
EAL_ALLOW_LOOPBACK_HTTP=true
EAL_API_TIMEOUT_SECONDS=20
EAL_API_RESPONSE_LIMIT_BYTES=2097152
EAL_CRAWL_COMMAND=/absolute/path/to/eal-crawl-adapter
EAL_WORKER_OWNER=local-canary
RUST_LOG=info,eal_crawl_runtime=debug
