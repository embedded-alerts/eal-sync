BIND_ADDR=127.0.0.1:8084
RUST_LOG=info,tower_http=info

# Operator-only crawl_once certification input. Do not mount this binary as a
# public arbitrary-URL fetch endpoint.
EAL_CRAWL_URL=https://example.com/feed.xml
EAL_CRAWL_INCLUDE_SUBDOMAINS=false
EAL_CRAWL_ALLOWED_HOSTS=
# Comma-separated canonical absolute paths. When omitted, crawl_once is restricted
# to the path represented by EAL_CRAWL_URL.
EAL_CRAWL_ALLOWED_PATH_PREFIXES=
EAL_CRAWL_ETAG=
EAL_CRAWL_LAST_MODIFIED=
